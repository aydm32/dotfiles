# ─────────────────────────────────────────────────────────────
#  zathurarc — Zathura PDF viewer configuration
#  Themes: Normal (default) ↔ Gruvbox Dark  →  toggle: Ctrl+r
# ─────────────────────────────────────────────────────────────


# ── General behaviour ────────────────────────────────────────

set selection-clipboard clipboard       # yank selections to system clipboard
set adjust-open "best-fit"              # fit page to window on open
set pages-per-row 1                     # single-page layout by default
set scroll-page-aware true             # don't skip content at page edges
set scroll-full-overlap 0.01           # tiny overlap when paging
set zoom-min 10                         # minimum zoom %
set zoom-max 1000                       # maximum zoom %
set zoom-step 10                        # zoom increment per step
set render-loading true                 # show loading indicator
set render-loading-bg "#282828"         # loading bg matches dark theme
set render-loading-fg "#ebdbb2"         # loading fg matches dark theme
set statusbar-home-tilde true          # show ~ instead of full home path
set window-title-basename true         # show filename only in title bar
set database sqlite                     # persistent history / bookmarks


# ── Normal view colours (light / default) ────────────────────

set default-bg         "#3c3836"        # canvas background
set default-fg         "#3c3836"        # UI foreground text


# ── Gruvbox Dark recolor palette ─────────────────────────────
#  Activated / deactivated with  Ctrl+r
#  recolor-lightcolor → replaces white (page background)
#  recolor-darkcolor  → replaces black (text / lines)

set recolor-lightcolor "#282828"        # Gruvbox dark bg0
set recolor-darkcolor  "#ebdbb2"        # Gruvbox light fg
set recolor-keephue    true             # preserve hues — colors flip dark, not stripped


# ── Statusbar ────────────────────────────────────────────────

set statusbar-fg       "#ebdbb2"        # Gruvbox fg (readable in both modes)
set statusbar-bg       "#504945"        # Gruvbox bg2
set statusbar-h-padding 8
set statusbar-v-padding 4


# ── Input bar ────────────────────────────────────────────────

set inputbar-fg        "#ebdbb2"
set inputbar-bg        "#1d2021"        # Gruvbox hard dark bg


# ── Notifications ────────────────────────────────────────────

set notification-fg    "#ebdbb2"
set notification-bg    "#504945"

set notification-error-fg   "#fb4934"  # Gruvbox bright red
set notification-error-bg   "#1d2021"

set notification-warning-fg "#fabd2f"  # Gruvbox bright yellow
set notification-warning-bg "#1d2021"


# ── Completion menu ──────────────────────────────────────────

set completion-fg           "#ebdbb2"
set completion-bg           "#282828"
set completion-group-fg     "#83a598"  # Gruvbox bright blue
set completion-group-bg     "#1d2021"
set completion-highlight-fg "#282828"
set completion-highlight-bg "#83a598"


# ── Index / Table of Contents ────────────────────────────────

set index-fg                "#ebdbb2"
set index-bg                "#282828"
set index-active-fg         "#282828"
set index-active-bg         "#d79921"  # Gruvbox yellow — easy to spot


# ── Highlight colours (search matches, visual select) ────────

set highlight-color         "#fabd2f"  # Gruvbox bright yellow (search)
set highlight-active-color  "#fe8019"  # Gruvbox bright orange (active match)
set highlight-transparency  0.5


# ── Key bindings ─────────────────────────────────────────────
#  Ctrl+r is Zathura's built-in recolor toggle — no extra map needed.
#  Additional ergonomic shortcuts below:

map <C-=> zoom in
map <C--> zoom out
map <C-0> zoom "best-fit"
map <Space> scroll down
map <S-Space> scroll up
map <C-d> scroll "half-down"
map <C-u> scroll "half-up"
map R reload
map p print


# ── End of zathurarc ─────────────────────────────────────────
